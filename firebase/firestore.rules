rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function self(uid) { return signed() && request.auth.uid == uid; }
  function deleting(uid) { return exists(/databases/$(database)/documents/deletingUsers/$(uid)); }
  function active() { return signed() && !deleting(request.auth.uid); }
  function verified() { return active() && request.auth.token.email_verified == true; }
  function gp(gid) { return /databases/$(database)/documents/eventGroups/$(gid); }
  function pp(gid,uid) { return /databases/$(database)/documents/eventGroups/$(gid)/participants/$(uid); }
  function owner(gid) { return signed() && get(gp(gid)).data.organizerId == request.auth.uid; }
  function openGroup(gid) { let g = get(gp(gid)).data; return g.status == 'active' && !deleting(g.organizerId); }
  function ownerAfter(gid) { return signed() && getAfter(gp(gid)).data.organizerId == request.auth.uid; }
  function token(gid) { return gid.matches('^[a-f0-9]{64}$'); }
  function publicMatches(gid,v) {
   let g = getAfter(gp(gid)).data;
   return v.eventId == g.eventId && v.organizerName == g.organizerName && v.status == g.status && v.createdAt == g.createdAt && v.yesCount == g.yesCount && v.registeredCount == g.registeredCount && v.revision == g.revision;
  }
  function yesBefore(gid,uid) { return exists(pp(gid,uid)) && get(pp(gid,uid)).data.response == 'yes' ? 1 : 0; }
  function yesAfter(gid,uid) { return existsAfter(pp(gid,uid)) && getAfter(pp(gid,uid)).data.response == 'yes' ? 1 : 0; }
  function registeredBefore(gid,uid) { return exists(pp(gid,uid)) && get(pp(gid,uid)).data.response == 'yes' && get(pp(gid,uid)).data.registrationStatus == 'registered' ? 1 : 0; }
  function registeredAfter(gid,uid) { return existsAfter(pp(gid,uid)) && getAfter(pp(gid,uid)).data.response == 'yes' && getAfter(pp(gid,uid)).data.registrationStatus == 'registered' ? 1 : 0; }
  function participantCounts(gid) {
   let uid = request.auth.uid;
   return request.resource.data.yesCount == resource.data.yesCount + yesAfter(gid,uid) - yesBefore(gid,uid) && request.resource.data.registeredCount == resource.data.registeredCount + registeredAfter(gid,uid) - registeredBefore(gid,uid);
  }
  match /deletingUsers/{uid} {
   allow get: if signed();
   allow create: if self(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is string;
   allow update: if self(uid) && request.resource.data == resource.data;
  }
  match /users/{uid} {
   allow get: if self(uid) && active();
   allow create, update: if self(uid) && active() && request.resource.data.keys().hasOnly(['firstName','lastName','email','createdAt','updatedAt']) && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 60 && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 80 && request.resource.data.email == request.auth.token.email && request.resource.data.createdAt is string && request.resource.data.updatedAt is string;
   allow delete: if self(uid) && deleting(uid);
  }
  match /privateNabv/{uid} {
   function permittedOrganizer() {
    let grant = get(/databases/$(database)/documents/nabvGrants/$(uid)/organizers/$(request.auth.uid)).data;
    let g = get(gp(grant.groupId)).data;
    let p = get(pp(grant.groupId,uid)).data;
    return active() && !deleting(uid) && g.organizerId == request.auth.uid && g.status == 'active' && p.response == 'yes' && p.shareNabvWithOrganizer == true;
   }
   allow get: if signed() && ((self(uid) && active()) || permittedOrganizer());
   allow create, update: if self(uid) && active() && request.resource.data.keys().hasOnly(['number','updatedAt']) && request.resource.data.number is string && request.resource.data.number.size() <= 30 && (request.resource.data.number == '' || request.resource.data.number.matches('^[A-Za-z0-9 -]{2,30}$')) && request.resource.data.updatedAt is string;
   allow delete: if self(uid) && deleting(uid);
  }
  // The pointer proves consent for one active group; it contains no NABV number.
  match /nabvGrants/{uid}/organizers/{oid} {
   allow read: if self(uid) || self(oid);
   allow create, update: if active() && (self(uid) || self(oid)) && request.resource.data.keys().hasOnly(['groupId']) && token(request.resource.data.groupId) && get(gp(request.resource.data.groupId)).data.organizerId == oid && openGroup(request.resource.data.groupId) && get(pp(request.resource.data.groupId,uid)).data.response == 'yes' && get(pp(request.resource.data.groupId,uid)).data.shareNabvWithOrganizer == true && !deleting(uid);
   allow delete: if self(uid) || self(oid);
  }
  match /groupLimits/{uid} {
   allow get: if self(uid);
   allow create: if self(uid) && verified() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
   allow update: if self(uid) && verified() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 100;
   allow delete: if self(uid) && deleting(uid);
  }
  match /eventGroups/{gid} {
   allow get: if signed() && token(gid);
   allow create: if verified() && token(gid) && request.resource.data.keys().hasOnly(['eventId','organizerId','organizerName','status','createdAt','yesCount','registeredCount','revision']) && request.resource.data.organizerId == request.auth.uid && request.resource.data.eventId is string && request.resource.data.eventId.size() <= 200 && request.resource.data.organizerName is string && request.resource.data.organizerName.size() <= 141 && request.resource.data.status == 'active' && request.resource.data.createdAt is string && request.resource.data.yesCount == 0 && request.resource.data.registeredCount == 0 && request.resource.data.revision == 0;
   allow update: if signed() && request.resource.data.organizerId == resource.data.organizerId && request.resource.data.eventId == resource.data.eventId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.yesCount is int && request.resource.data.yesCount >= 0 && request.resource.data.registeredCount is int && request.resource.data.registeredCount >= 0 && request.resource.data.registeredCount <= request.resource.data.yesCount &&
    ((owner(gid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizerName','status','yesCount','registeredCount','revision']) && request.resource.data.organizerName is string && request.resource.data.organizerName.size() <= 141 && request.resource.data.status in ['active','revoked'] && (resource.data.status == 'active' || request.resource.data.status == 'revoked')) ||
    (((verified() && resource.data.status == 'active') || deleting(request.auth.uid)) && request.resource.data.status == resource.data.status && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yesCount','registeredCount','revision']) && request.resource.data.revision == resource.data.revision + 1 && participantCounts(gid)));
   allow delete: if owner(gid) && resource.data.status == 'revoked';
   match /participants/{uid} {
    function validResponse() {
     let v = request.resource.data;
     let u = get(/databases/$(database)/documents/users/$(uid)).data;
     return v.keys().hasOnly(['userId','name','response','registrationStatus','shareNabvWithOrganizer','allowNabvForwarding','respondedAt','responseChanged','consentAt','profileChangedAt']) && v.userId == uid && v.name == u.firstName + ' ' + u.lastName && v.response in ['yes','no'] && v.registrationStatus in ['pending','registered','cancelled'] && v.shareNabvWithOrganizer is bool && v.allowNabvForwarding is bool && v.responseChanged is bool && v.respondedAt is string && v.consentAt is string && (!v.shareNabvWithOrganizer || (v.response == 'yes' && get(/databases/$(database)/documents/privateNabv/$(uid)).data.number.size() > 0)) && (!v.allowNabvForwarding || v.shareNabvWithOrganizer);
    }
    allow get: if signed() && ((self(uid) && (openGroup(gid) || deleting(uid))) || owner(gid));
    allow list: if owner(gid);
    allow create: if self(uid) && verified() && openGroup(gid) && validResponse() && request.resource.data.registrationStatus == 'pending' && request.resource.data.responseChanged == false;
    allow update: if (self(uid) && verified() && openGroup(gid) && validResponse() && request.resource.data.registrationStatus == resource.data.registrationStatus && (request.resource.data.response == resource.data.response ? request.resource.data.responseChanged == resource.data.responseChanged : request.resource.data.responseChanged == true)) || (owner(gid) && active() && openGroup(gid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationStatus','responseChanged']) && request.resource.data.registrationStatus in ['pending','registered','cancelled'] && request.resource.data.responseChanged == false);
    allow delete: if (self(uid) && deleting(uid)) || (owner(gid) && get(gp(gid)).data.status == 'revoked');
   }
  }
  match /publicInvites/{gid} {
   allow get: if token(gid);
   allow create, update: if signed() && token(gid) && request.resource.data.keys().hasOnly(['eventId','organizerName','status','createdAt','yesCount','registeredCount','revision']) && publicMatches(gid,request.resource.data) && (ownerAfter(gid) || existsAfter(pp(gid,request.auth.uid)) || deleting(request.auth.uid));
   allow delete: if owner(gid) && get(gp(gid)).data.status == 'revoked';
  }
  match /users/{uid}/groups/{gid} {
   allow list: if self(uid);
   allow get: if self(uid) || owner(gid);
   allow create, update: if signed() && request.resource.data.keys().hasOnly(['id','eventId','organizerName','status','createdAt','yesCount','registeredCount','revision','role','response','registrationStatus','needsAttention']) && publicMatches(gid,request.resource.data) &&
    ((self(uid) && (ownerAfter(gid) ? request.resource.data.role == 'organizer' : (request.resource.data.role == 'participant' && request.resource.data.response == getAfter(pp(gid,uid)).data.response && request.resource.data.registrationStatus == getAfter(pp(gid,uid)).data.registrationStatus))) ||
    (getAfter(gp(gid)).data.organizerId == uid && request.resource.data.role == 'organizer' && (existsAfter(pp(gid,request.auth.uid)) || deleting(request.auth.uid))) ||
    (owner(gid) && (get(gp(gid)).data.status == 'revoked' || (request.resource.data.response == getAfter(pp(gid,uid)).data.response && request.resource.data.registrationStatus == getAfter(pp(gid,uid)).data.registrationStatus))));
   allow delete: if self(uid) || owner(gid);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
